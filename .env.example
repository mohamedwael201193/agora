# Agora Wave-2 Environment Configuration
# Copy this file to .env.local and update with your deployment values

# ============================================================================
# NETWORK CONFIGURATION
# ============================================================================
LINERA_NETWORK=local

# ============================================================================
# LINERA WALLET (Generated by localnet)
# ============================================================================
# These paths are auto-generated when you run `make localnet`
# Format: /tmp/.tmp{RANDOM}/wallet_0.json
LINERA_WALLET=/tmp/.tmpXXXXXX/wallet_0.json
LINERA_KEYSTORE=/tmp/.tmpXXXXXX/keystore_0.json
LINERA_STORAGE=rocksdb:/tmp/.tmpXXXXXX/client_0.db

# ============================================================================
# AGORA APPLICATION (From publish-and-create output)
# ============================================================================
# Application ID printed by: linera publish-and-create ...
AGORA_APP_ID=

# GraphQL service port
SERVICE_PORT=8081

# ============================================================================
# CHAIN IDS (From localnet wallet)
# ============================================================================
# Registry chain: Where you created the app with InitArg::Registry
REGISTRY_CHAIN_ID=

# Default chain: Your wallet's default chain
DEFAULT_CHAIN_ID=

# Market chain: Target chain for creating markets
MARKET_CHAIN_ID=

# ============================================================================
# FRONTEND CONFIGURATION (Vite)
# ============================================================================
# Dev server port
VITE_PORT=8080

# Linera node GraphQL endpoint
VITE_NODE_URL=http://localhost:8081

# Application ID (same as AGORA_APP_ID)
VITE_AGORA_APP_ID=

# Registry chain ID (same as REGISTRY_CHAIN_ID)
VITE_REGISTRY_CHAIN_ID=

# Network indicator (shows localnet banner in UI)
VITE_NETWORK=local

# API Base URL
VITE_API_URL=http://localhost:8081

# Vite Frontend Variables (Wave-2)
VITE_AGORA_APP_ID=
VITE_REGISTRY_CHAIN_ID=
VITE_NODE_URL=http://localhost:8081

# Legacy Conway Testnet Variables (Wave-1 Counter)
VITE_LINERA_CHAIN_ID=89131c54689afcc8a2194b49620666fe6a217a0f37056c407adcbed1419fa903
VITE_LINERA_APP_ID=d083140503828dae69d9562e2f39efd607eb9ec64464f23403255a71e740aea3
VITE_LINERA_FAUCET_URL=https://faucet.testnet-conway.linera.net
VITE_LINERA_VALIDATOR_URL=https://validator.testnet-conway.linera.net
VITE_LINERA_GRAPHQL_ENDPOINT=http://localhost:8081
VITE_LINERA_RPC_ENDPOINT=http://localhost:8080

# Application Metadata
VITE_APP_NAME=Agora
VITE_NETWORK=local